<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Театр Аквариум</title>
    <link rel="stylesheet" href="/css/index/main.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
</head>
<body>
    <%- include("partials/header") %>
    
    <section class="actor">
        <h1 class="actor__name wave"> <%= actor.first_name %> <%= actor.last_name %> <%= actor.patronymic %> </h1>
        <div class="actor__wrapper">
            <div class="swiper actor__swiper" tabindex="0">
                <div class="swiper-wrapper actor__swiper-wrapper">
                    <div class="swiper-slide">
                        <img class="actor__image" width="800px" src="<%= actor.img1 %>" alt="Фото актера">
                    </div>
                    <div class="swiper-slide">
                        <img class="actor__image" width="800px" src="<%= actor.img2 %>" alt="Фото актера">
                    </div>
                    <div class="swiper-slide">
                        <img class="actor__image" width="800px" src="<%= actor.img3 %>" alt="Фото актера">
                    </div>
                </div>
                <div class="swiper-pagination"></div>
            </div>
            <svg class="actor__arrow-back" height="72" width="72" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M6 12H18M6 12L11 7M6 12L11 17" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
            <svg class="actor__arrow-next" height="72" width="72" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M6 12H18M18 12L13 7M18 12L13 17" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
        </div>
        <ul class="actor__achievements achievement-list">
            <li class="achievement-list__item actor__biografy"> <%= actor.biografy  %> </li>
            <% const achievementsList = actor.achievements.split(',').map(item => item.trim()) %>
            <% achievementsList.forEach(item => { %>
            <li class="achievement-list__item"> <%= item %> </li>
            <% }); %>
        </ul>        
        <h3 class="starring-title">Участвует в спектаклях:</h3>
        <ul class="actor__starring starring-list">
            <ul class="performance-list">
                <%
                const filteredPerformances = performances.filter(performance =>
                    performancesList.some(item =>
                        item.performance_id === performance.performance_id
                    )
                );
                %>
                <% filteredPerformances.forEach(performance => { %>
                    <li class="performance-list__item">
                        <figure class="performance-figure">
                            <a href="/performance/<%= performance.performance_id %>" >
                                <img class="performance__image" src="<%= performance.img1 %>" width="400" height="225px" alt="Фото спектакля">
                                <p class="performance__image-description">Узнать о спектакле подробнее</p>
                            </a>
                            <figcaption class="performance__figcaption">
                                <svg height="25" width="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M12 7V12L13.5 14.5M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="#114d94" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
                                <%= performance.duration %> минут <%= performance.age_limit %>
                            </figcaption>
                        </figure>
                        <div class="performance__info">
                            <h3 class="performance__title"> <%= performance.title %> </h3>
                            <span class="performance__author"> <%= performance.description %> </span>
                        </div>
                    </li>
                <% }) %>
            </ul>
        </ul>
    </section>

    <%- include("partials/footer") %>
    <script type="module" src="/js/menu.js"></script>
    <script type="module" src="/js/actor.js"></script>
</body>
</html>