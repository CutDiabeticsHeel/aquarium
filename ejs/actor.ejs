        <div class="ticket-office-wrapper">
            <ul class="ticket-office-list">
                <li class="ticket-office-list__item">Режим работы кассы театра:</li>
                <li class="ticket-office-list__item">ЧЕТВЕРГ 15:00 - 19:30</li>
                <li class="ticket-office-list__item">ПЯТНИЦА 15:00 - 20:00</li>
                <li class="ticket-office-list__item">СУББОТА 10:00 - 19:00</li>
                <li class="ticket-office-list__item">ВОСКРЕСЕНЬЕ 9:30 - 17:00</li>
            </ul>
            <ul class="ticket-office-contact">
                <li class="ticket-office-contact__item">Телефоны кассы:</li>
                <li class="ticket-office-contact__item">8 812 590 4259</li>
                <li class="ticket-office-contact__item">8 929 111 2000</li>
            </ul>
            <ul class="ticket-office-price">
                <li class="ticket-office-price__item">Стоимость билетов:</li>
                <li class="ticket-office-price__item">Кукольный спектакль - 700 рублей</li>
                <li class="ticket-office-price__item">Музыкально-драматический - 800 рублей</li>
            </ul>
        </div>
        <iframe class="main-footer__map" src="https://yandex.ru/map-widget/v1/?um=constructor%3A478111c2196b5bea4b468fb3d45b34905f60f240d80755581aafed79ad7a7e3d&amp;source=constructor" width="902" height="425" frameborder="0"></iframe>
    </footer>
    <script type="module" src="/js/actor.js"></script>
</body>
</html>