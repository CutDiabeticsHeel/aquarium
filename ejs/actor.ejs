<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Театр Аквариум</title>
    <link rel="stylesheet" href="/css/index/main.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
</head>
<body>
    <header class="main-header">
        <a class="title-wrapper" href="/index">
            <svg fill="#ffffff" width="75" height="75" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 965.25 965.25" xml:space="preserve"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <polygon points="0,238.932 965.25,238.932 482.625,2.332 "></polygon> <rect x="93.559" y="389.189" width="78.428" height="390.143"></rect> <rect x="326.793" y="389.189" width="78.428" height="390.143"></rect> <rect x="560.028" y="389.189" width="78.428" height="390.143"></rect> <rect x="793.262" y="389.189" width="78.428" height="390.143"></rect> <polygon points="913.49,354.189 913.49,275.114 51.759,275.114 51.759,354.189 93.559,354.189 171.987,354.189 326.793,354.189 405.221,354.189 560.028,354.189 638.456,354.189 793.262,354.189 871.69,354.189 "></polygon> <path d="M897.614,869.371H871.69v-55.039h-78.428H638.456h-78.428H405.221h-78.428H171.987H93.559v55.039H67.636 c-24.346,0-44.082,19.736-44.082,44.082v49.465h918.142v-49.465C941.695,889.107,921.959,869.371,897.614,869.371z"></path> </g> </g></svg>
            <p class="title"><span>Детский театр</span> АКВАРИУМ</p>
        </a>
        <nav class="main-navigation">
            <ul class="navigation-list">
                <li class="navigation-list__item"><a class="under-line-link" href="/playbill">Афиша</a></li>
                <li class="navigation-list__item"><a class="under-line-link" href="/index#services">Услуги</a></li>
                <li class="navigation-list__item"><a class="under-line-link" href="/troupe">Труппа театра</a></li>
                <li class="navigation-list__item"><a class="under-line-link" href="/repertoire">Наши спектакли</a></li>                
                <li class="navigation-list__item"><a class="under-line-link" href="/index#about-theatre">О театре</a></li>
                <li class="navigation-list__item"><a class="under-line-link" href="/reviews">Отзывы</a></li>
            </ul>
        </nav>
        <button class="buy-ticket">Купить билет</button>        
    </header>
    
    <section class="actor">
        <h1 class="actor__name wave"> <%= actor.first_name %> <%= actor.last_name %> <%= actor.patronymic %> </h1>
        <div class="actor__wrapper">
            <div class="swiper actor__swiper" tabindex="0">
                <div class="swiper-wrapper actor__swiper-wrapper">
                    <div class="swiper-slide">
                        <img class="actor__image" width="800px" src="<%= actor.img1 %>" alt="Фото актера">
                    </div>
                    <div class="swiper-slide">
                        <img class="actor__image" width="800px" src="<%= actor.img2 %>" alt="Фото актера">
                    </div>
                    <div class="swiper-slide">
                        <img class="actor__image" width="800px" src="<%= actor.img3 %>" alt="Фото актера">
                    </div>
                </div>
                <div class="swiper-pagination"></div>
            </div>
            <svg class="actor__arrow-back" height="72" width="72" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M6 12H18M6 12L11 7M6 12L11 17" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
            <svg class="actor__arrow-next" height="72" width="72" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M6 12H18M18 12L13 7M18 12L13 17" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
        </div>
        <ul class="actor__achievements achievement-list">
            <li class="achievement-list__item actor__biografy"> <%= actor.biografy  %> </li>
            <% const achievementsList = actor.achievements.split(',').map(item => item.trim()) %>
            <% achievementsList.forEach(item => { %>
            <li class="achievement-list__item"> <%= item %> </li>
            <% }); %>
        </ul>        
        <h3 class="starring-title">Участвует в спектаклях:</h3>
        <ul class="actor__starring starring-list">
            <% performancesList.forEach(item => { %>
                <li class="starring-list_item"><a href="/performance/<%= item.performance_id %>"> <%= item.title %> </a></li>
            <% }); %>
        </ul>
    </section>

    <footer class="main-footer">
        <span class="main-footer wave"></span>
        <h2 class="main-footer__title-contact">Контакты</h2>
        <h2 class="main-footer__title-ticket-office">Театральная Касса</h2>
        <h2 class="main-footer__title-map ">Где нас найти</h2>
