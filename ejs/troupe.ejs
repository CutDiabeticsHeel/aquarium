<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Театр Аквариум</title>
    <link rel="stylesheet" href="/css/index/main.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/gsap.min.js"></script>
    <script type="module" src="/js/curtains.js"></script>
</head>
<body>
    <%- include("partials/header") %>
    <%- include("partials/curtains") %>
    
    <section class="troupe-section">
        <h1 class="wave">Труппа теара</h1>
        
        <ul class="actors-list">
            <% troupe.forEach(actor => { %>
                <li class="actors-list__item">
                    <a class="actors-list__link" href="/actor/<%= actor.actor_id %>" data-actorId="<%= actor.actor_id %>">
                        <img class="actors__image" src="<%= actor.portrait %>"  width="250" height="250" alt="Фото">
                        <span class="actors__info"> <%= actor.first_name %> <%= actor.last_name %> <br> <%= actor.role_name %> </span>
                    </a>
                </li>
            <% }) %>
        </ul>
    </section>

    <%- include("partials/footer") %>
    
    <script type="module" src="/js/menu.js"></script>
    <script type="module" src="/js/footer.js"></script>
    <script type="module" src="/js/troupe.js"></script>
</body>
</html>