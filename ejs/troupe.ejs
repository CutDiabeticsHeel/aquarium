<!DOCTYPE html>
<html lang="ru">
<head>
    <%- include("partials/head") %>
</head>
<body>
    <%- include("partials/header") %>
    <main>
        <%- include("partials/curtains") %>
        
        <section class="troupe-section">
            <h1 class="wave">Труппа театра</h1>
            
            <ul class="actors-list">
                <% troupe.forEach((actor, index) => { %>
                    <li class="actors-list__item">
                        <a class="actors-list__link" href="/actor/<%= actor.actor_id %>" data-actorId="<%= actor.actor_id %>">
                            <img
                                class="actors__image"
                                src="<%= withWidth(actor.portrait, 1024) %>"
                                loading="<%= index >= 9 ? 'lazy' : 'eager' %>"
                                decoding="async"
                                width="250" height="250"
                                srcset="<%= SIZES.map(w => `${withWidth(actor.portrait, w)} ${w}w`).join(', ') %>"
                                sizes="(max-width: 600px) 375px, (max-width: 1024px) 768px, 1024px"
                                alt="Портрет актера <%= actor.first_name %> <%= actor.last_name %>"
                            >
                            <span class="actors__info"> <%= actor.first_name %> <%= actor.last_name %> <br> <%= actor.role_name %> </span>
                        </a>
                    </li>
                <% }) %>
            </ul>
        </section>
    </main>

    <%- include("partials/footer") %>
</body>
</html>