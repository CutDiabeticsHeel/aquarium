<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Театр Аквариум</title>
    <link rel="stylesheet" href="/css/index/main.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://unpkg.com/@js-temporal/polyfill@0.4.4/dist/index.umd.js"></script>
</head>

<body>

    <%- include("partials/header") %>

    <h1 class="wave">Афиша</h1>

    <section class="playbill">

        <img class="no-js" style="display: none;" src="/img/playbill.jpg" alt="">

        <ul class="dates-list">
        </ul>

        <ul class="performances-list">
            <% if (performances && performances.length > 0) { %>
                <% performances.forEach(performance => { %>
                    <li class="performances-list__item" data-date="<%=performance.date%>">
                        <h3><%= performance.performance %></h3>
                        <span><%= performance.date %></span>
                        <span><%= performance.age_limit %></span>
                        <button class="buy-ticket">Купить билет</button>
                        <img class="playbill__image" src="<%= performance.image %>" width="400px" height="400px" alt='Фото спектакля "<%= performance.performance %>"'>
                    </li>
                <% }); %>
            <% } %>
        </ul>
        <span class="hidden-modal">В этот день нет спектаклей :(</span>

    </section>

    <%- include("partials/footer") %>
    <script type="module" src="/js/menu.js"></script>
    <script type="module" src="/js/playbill.js"></script>

</body>
</html>