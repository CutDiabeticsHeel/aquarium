<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("partials/head") %>
</head>
<body>
    <div class="login__wrapper">
        <form class="login__form" action="/admin" method="POST">
            <h1>Введите логин и пароль чтобы войти в панель администратора</h1>
            <input class="input admin__username" type="text" placeholder="Username" name="username" id="username" autocomplete="off">
            <input class="input admin__password" type="password" placeholder="Password" name="password" id="password">
            <button class="buy-ticket login__button" type="submit">Login</button>
        </form>
    </div>
</body>
</html>