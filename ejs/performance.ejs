<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Театр Аквариум</title>
    <link rel="stylesheet" href="/css/index/main.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui@6.1/dist/fancybox/fancybox.css"/>
    <script src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@6.1/dist/fancybox/fancybox.umd.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
</head>
<body>
    <%- include("partials/header") %>

    <section class="performance">
        <h1 class="wave performance-title">Школа барона Мюнхгаузена</h1>
        <div class="performance__wrapper">
            <div class="performance__text">
                <span class="performance__origin"><%= performanceData.origin %></span>
                <p class="performance__description"><%= performanceData.info%></p>
                <span class="performance__audience"><%= performanceData.audience%></span>
            </div>
            <div class="performance__swiper-container">
                <div class="swiper performance__swiper" tabindex="0">
                    <div class="swiper-wrapper performance__swiper-wrapper">
                        <div class="swiper-slide">
                            <a href="<%= performanceData.img1 %>" data-fancybox="performance__gallery">                            
                                <img class="performance-swiper__image" src="<%= performanceData.img1 %>" width="50px" height="50px" alt="Фото спектакля">
                            </a>
                        </div>
                        <div class="swiper-slide">
                            <a href="<%= performanceData.img2 %>" data-fancybox="performance__gallery">
                                <img class="performance-swiper__image" src="<%= performanceData.img2 %>" width="50px" height="50px" alt="Фото спектакля">
                            </a>
                        </div>
                        <div class="swiper-slide">
                            <a href="<%= performanceData.img3 %>" data-fancybox="performance__gallery">
                                <img class="performance-swiper__image" src="<%= performanceData.img3 %>" width="50px" height="50px" alt="Фото спектакля">
                            </a>
                        </div>
                    </div>
                    <div class="swiper-pagination"></div>
                </div>
                <svg class="performance__arrow-back" height="72" width="72" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M6 12H18M6 12L11 7M6 12L11 17" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
                <svg class="performance__arrow-next" height="72" width="72" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M6 12H18M18 12L13 7M18 12L13 17" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
            </div> 
            <h2 class="roles wave">В ролях</h2>
            <div class="starring">
                <ul class="actors-list">
                    <% starringList.forEach(item => { %>
                    <li class="actors-list__item">
                        <a class="actors-list__link" href="/actor/<%= item.actor_id %>">
                            <img class="actors__image" src="<%= item.portrait %>" width="300" height="300" alt="Фото актера">
                            <span class="actors__fcs"><%= item.first_name %> <%= item.last_name %> </span>
                            <span class="actors__role"> <%= item.character_name %></span>
                        </a>
                    </li>
                    <% }); %>
                </ul>
            </div>
        </div>
    </section>

    <%- include("partials/footer") %>
    <script type="module" src="/js/menu.js"></script>
    <script type="module" src="/js/performance.js"></script>
</body>
</html>