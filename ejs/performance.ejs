<!DOCTYPE html>
<html lang="ru">
<head>
    <%- include("partials/head") %>
</head>
<body>
    <%- include("partials/header") %>
    <main>
        <%- include("partials/curtains") %>

        <section class="performance">
            <h1 class="wave performance-title"><%= performanceData.title %></h1>
            <div class="performance__wrapper">
                <div class="performance__text">
                    <span class="performance__origin"><%= performanceData.origin %></span>
                    <p class="performance__description"><%= performanceData.info%></p>
                    <span class="performance__audience"><%= performanceData.audience%></span>
                </div>
                <div class="performance__swiper-container">
                    <div class="swiper performance__swiper" tabindex="0">
                        <div class="swiper-wrapper performance__swiper-wrapper">
                            <div class="swiper-slide">
                                <a href="<%= performanceData.img1 %>" data-fancybox="performance__gallery">                            
                                    <img class="performance-swiper__image" src="<%= performanceData.img1 %>" width="50px" height="50px" alt="Фото спектакля">
                                </a>
                            </div>
                            <div class="swiper-slide">
                                <a href="<%= performanceData.img2 %>" data-fancybox="performance__gallery">
                                    <img class="performance-swiper__image" src="<%= performanceData.img2 %>" width="50px" height="50px" alt="Фото спектакля">
                                </a>
                            </div>
                            <div class="swiper-slide">
                                <a href="<%= performanceData.img3 %>" data-fancybox="performance__gallery">
                                    <img class="performance-swiper__image" src="<%= performanceData.img3 %>" width="50px" height="50px" alt="Фото спектакля">
                                </a>
                            </div>
                        </div>
                        <div class="swiper-pagination"></div>
                    </div>
                    <svg class="performance__arrow-back" width="72" height="72" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <circle class="base-circle" cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/>
                        <circle class="hover-circle" cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2.5"/>
                        <path d="M12 8L8 12M8 12L12 16M8 12H16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    </svg>
                    <svg class="performance__arrow-next" width="72" height="72" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <circle class="base-circle" cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/>
                        <circle class="hover-circle" cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2.5"/>
                        <path d="M12 16L16 12M16 12L12 8M16 12H8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    </svg>
                </div> 
                <h2 class="roles wave">В ролях</h2>
                <div class="starring">
                    <ul class="actors-list">
                        <% starringList.forEach(item => { %>
                        <li class="actors-list__item">
                            <a class="actors-list__link" href="/actor/<%= item.actor_id %>">
                                <img class="actors__image" src="<%= item.portrait %>" decoding="async" loading="lazy" width="250" height="250" alt="Фото актера">
                                <span class="actors__fcs"><%= item.first_name %> <%= item.last_name %> </span>
                                <span class="actors__role"> <%= item.character_name %></span>
                            </a>
                        </li>
                        <% }); %>
                    </ul>
                </div>
            </div>
        </section>
    </main>

    <%- include("partials/footer") %>
</body>
</html>