<!DOCTYPE html>
<html lang="ru">
<head>
    <link rel="stylesheet" href="/vendor/fancybox.css">
    <link rel="stylesheet" href="/vendor/swiper-bundle.min.css">
    <script src="/vendor/fancybox.umd.js" defer></script>
    <script src="/vendor/swiper-bundle.min.js" defer></script>
    <%- include("partials/head") %>
</head>
<body>
    <%- include("partials/header") %>
    <main>
        <%- include("partials/curtains") %>

        <section class="performance">
            <h1 class="wave performance-title"><%= performanceData.title %></h1>
            <div class="performance__wrapper">
                <div class="performance__text">
                    <span class="performance__origin"><%= performanceData.origin %></span>
                    <p class="performance__description"><%= performanceData.info%></p>
                    <span class="performance__audience"><%= performanceData.audience%></span>
                </div>
                <div class="performance__swiper-container">
                    <div class="swiper performance__swiper" tabindex="0">
                        <div class="swiper-wrapper performance__swiper-wrapper">
                            <% performanceData.imgs.forEach(image => { %>
                                <div class="swiper-slide">
                                    <a href="<%= withWidth(image, 1024) %>" data-fancybox="performance__gallery">
                                        <img
                                            class="performance-swiper__image"
                                            width="50" height="50"
                                            src="<%= withWidth(image, 375) %>"
                                            srcset="<%= SIZES.map(w => `${withWidth(image, w)} ${w}w`).join(', ') %>"
                                            sizes="50px"
                                            alt="Фото спектакля <%= performanceData.title %>"
                                        >                            
                                    </a>
                                </div>
                            <% }); %>
                        </div>
                        <div class="swiper-pagination"></div>
                    </div>
                    <svg class="performance__arrow-back" width="6vh" height="6vh" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <circle class="base-circle" cx="12" cy="12" r="10" fill="none" stroke="#ffffff" stroke-width="2"/>
                        <circle class="hover-circle" cx="12" cy="12" r="10" fill="none" stroke="#ffffff" stroke-width="2.5"/>
                        <path d="M12 8L8 12M8 12L12 16M8 12H16" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    </svg>
                    <svg class="performance__arrow-next" width="6vh" height="6vh" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <circle class="base-circle" cx="12" cy="12" r="10" fill="none" stroke="#ffffff" stroke-width="2"/>
                        <circle class="hover-circle" cx="12" cy="12" r="10" fill="none" stroke="#ffffff" stroke-width="2.5"/>
                        <path d="M12 16L16 12M16 12L12 8M16 12H8" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    </svg>
                </div> 
                <h2 class="roles wave">В ролях</h2>
                <div class="starring">
                    <% if (starringList.length === 0) {%>
                        <span class="zero-starring">Похоже в этом спектакле никто не участвует</span>
                    <%}%>
                    <ul class="actors-list">
                        <% starringList.forEach(actor => { %>
                        <li class="actors-list__item">
                            <a class="actors-list__link" href="/actor/<%= actor.actor_id %>">
                                <img
                                    class="actors__image"
                                    src="<%= withWidth(actor.portrait, 1024) %>"
                                    loading="lazy"
                                    decoding="async"
                                    width="250" height="250"
                                    srcset="<%= SIZES.map(w => `${withWidth(actor.portrait, w)} ${w}w`).join(', ') %>"
                                    sizes="(max-width: 600px) 375px, (max-width: 1024px) 768px, 1024px"
                                    alt="Портрет актера <%= actor.first_name %> <%= actor.last_name %>"
                                >
                                <span class="actors__fcs"><%= actor.first_name %> <%= actor.last_name %> </span>
                                <span class="actors__role"> <%= actor.role %></span>
                            </a>
                        </li>
                        <% }); %>
                    </ul>
                </div>
            </div>
        </section>
    </main>

    <%- include("partials/footer") %>
</body>
</html>