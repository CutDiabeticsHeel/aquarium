    <form class="add-actor" action="/add-actor" method="POST" enctype="multipart/form-data" autocomplete="new-password">
        <label>
            Введите Имя
            <input type="text" name="first_name" autocomplete="new-password"/>
        </label>
        <label>
            Введите Фамилию
            <input type="text" name="last_name" autocomplete="new-password"/>
        </label>
        <label>
            Введите Должность (Актер\Педагог)
            <input type="text" name="role_name" autocomplete="new-password"/>
        </label>
        <label>
            Введите Отчество 
            <input type="text" name="patronymic" autocomplete="new-password"/>
        </label>
        <label>
            Введите информацию когда родился актер 
            <input type="text" name="biografy" autocomplete="new-password"/>
        </label>
        <label>
            Введите информацию об актере, которую хотите вывести на страницу. 
            Предложения отделённые запятой(",") будут отображаться на странице с новой строки. 
            <input type="text" name="achievements" autocomplete="new-password"/>
        </label>
        <label for="imgs">Загрузите  одну или несколько фотографий для страницы актера
            <input type="file" id="imgs" name="imgs" multiple />
        </label>
        <label for="portrait">Загрузите портрет актера для страницы труппы
            <input type="file" id="portrait" name="portrait"/>
        </label>
        <button class="confirm-button" type="submit">Добавить</button>
    </form>