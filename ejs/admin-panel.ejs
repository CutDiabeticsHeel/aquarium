<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/css/bundle.css">
</head>
<body>
    <div class="reform__wrapper">
        <h1>Панель администратора</h1>
        <details class="reform__details" name="reform">
            <summary>Администрирование информации об актерах</summary>
            <details class="reform__details add__actor" name="reform__item">
                <summary>Добавить актера</summary>
                <%- include("partials/add-actor")%>
            </details>
            <details class="reform__details delete__actor" name="reform__item">
                <summary>Удалить Актера</summary>
                <form class="delete-actor" action="/delete-actor" method="POST" autocomplete="off">
                    <label>
                        Введите Имя
                        <input type="text" name="firstName" autocomplete="off"/>
                    </label>
                    <label>
                        Введите Фамилию
                        <input type="text" name="lastName" autocomplete="off"/>
                    </label>
                    <label>
                        Введите Отчество 
                        <input type="text" name="patronymic" autocomplete="off"/>
                    </label>
                    <button class="confirm-button" type="submit">Удалить</button>
                </form>
            </details>
            <details class="reform__details change__actor" name="reform__item">
                <summary>Изменить информацию об актере</summary>
                <h3>Сначала введите Фамилию актера, информацию которого хотите обновить</h3>
                <form class="find-actor" action="/find-actor" method="get" autocomplete="off">
                    <label>
                        Введите Фамилию
                        <input type="text" name="lastName" autocomplete="off"/>
                    </label>
                    <button class="confirm-button" type="submit">Поиск</button>
                </form>
            </details>
            <details class="reform__details" name="reform__item">
                <summary>Изменить/Добавить актерский состав спектакля</summary>
                <form class="update-cast" action="/update-cast" method="post" autocomplete="off">
                    <label>
                        Введите название спектакля
                        <input type="text" name="performanceTitle" autocomplete="off"/>
                    </label>
                    <label>
                        Введите роль, которую играет актер в этом пектакле
                        <input type="text" name="role" autocomplete="new-password"/>
                    </label>
                    <label>
                        Введите Имя
                        <input type="text" name="firstName" autocomplete="new-password"/>
                    </label>
                    <label>
                        Введите Фамилию
                        <input type="text" name="lastName" autocomplete="new-password"/>
                    </label>
                    <label>
                        Введите Отчество
                        <input type="text" name="patronymic" autocomplete="off"/>
                    </label>
                    <button class="confirm-button" type="submit">Обновить каст</button>
                </form>
            </details>
        </details>
        <details class="reform__details" name="reform">
            <summary>Администрирование спектаклей</summary>
            <details class="reform__details delete__actor" name="reform__item">
                <summary>Изменить информацию об спектакле / добавить спектакль</summary>
                <form class="redact-performance" action="/redact-performance" method="POST" enctype="multipart/form-data" autocomplete="off">
                    <label>
                        Введите название спектакля
                        <input type="text" name="title" autocomplete="off"/>
                    </label>
                    <label>
                        Введите длительность спектакля в минутах (Страница всех спектаклей)
                        <input type="text" name="duration" autocomplete="new-password"/>
                    </label>
                    <label>
                        Введите возрастное ограничение. Пример: 14+ (Страница всех спектаклей)
                        <input type="text" name="ageLimit" autocomplete="new-password"/>
                    </label>
                    <label>
                        Введите краткое описание, которое показывается на странице всех спектаклей (Страница всех спектаклей)
                        <input type="text" name="description" autocomplete="new-password"/>
                    </label>
                    <label>
                        Введите по мотивам чего поставлен спектакль / его первоисточник (Страница спектакля)
                        <input type="text" name="origin" autocomplete="new-password"/>
                    </label>
                    <label>
                        Введите аудиторию спектакля (Страница спектакля)
                        <input type="text" name="audience" autocomplete="new-password"/>
                    </label>
                    <label>
                        Введите краткое описание спектакля (Страница спектакля)
                        <input type="text" name="info" autocomplete="new-password"/>
                    </label>
                    <label for="imgs">Загрузите одну или несколько фотографий для страницы спектакля
                        <input type="file" id="imgs" name="imgs" multiple />
                    </label>
                    <label for="titleImage">Загрузите приветственное изображения спектакля для афиши и страницы всех спектаклей
                        <input type="file" id="titleImage" name="titleImage"/>
                    </label>
                    <button class="confirm-button" type="submit">Внести изменения</button>
                </form>
            </details>
            <details class="reform__details delete__actor" name="reform__item">
                <summary>Удалить спектакль</summary>
                <form class="delete-actor" action="/delete-performance" method="POST" autocomplete="off">
                    <label>
                        Введите Название спектакля
                        <input type="text" name="title" autocomplete="off"/>
                    </label>
                    <button class="confirm-button" type="submit">Удалить</button>
                </form>
            </details>
        </details>
        <details class="reform__details" name="reform">
            <summary>Изменить афишу</summary>
            <p>Добавить спектакль в афишу</p>
        </details>
        <details class="reform__details" name="reform">
            <summary>Изменить отзывы</summary>
            <p>Одобрить отзыв</p>
        </details>
    </div>
</body>
</html>